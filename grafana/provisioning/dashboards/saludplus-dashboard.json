{
  "title": "SaludPlus - Observabilidad CI/CD (EP3)",
  "uid": "saludplus-ep3",
  "timezone": "browser",
  "refresh": "10s",
  "time": { "from": "now-6h", "to": "now" },
  "panels": [
    {
      "id": 1,
      "title": "Disponibilidad del microservicio",
      "type": "stat",
      "datasource": { "type": "prometheus", "uid": "prometheus_ds" },
      "gridPos": { "h": 6, "w": 6, "x": 0, "y": 0 },
      "targets": [
        { "expr": "up{job=\"saludplus-service\"}", "legendFormat": "saludplus-service" }
      ],
      "fieldConfig": {
        "defaults": {
          "mappings": [
            { "type": "value", "options": { "0": { "text": "CAIDO", "color": "red" }, "1": { "text": "UP", "color": "green" } } }
          ],
          "thresholds": { "mode": "absolute", "steps": [ { "color": "red", "value": null }, { "color": "green", "value": 1 } ] }
        }
      }
    },
    {
      "id": 2,
      "title": "Cobertura de pruebas (ultimo build CI)",
      "type": "stat",
      "datasource": { "type": "prometheus", "uid": "prometheus_ds" },
      "gridPos": { "h": 6, "w": 6, "x": 6, "y": 0 },
      "targets": [
        { "expr": "saludplus_test_coverage_ratio * 100", "legendFormat": "cobertura %" }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "thresholds": { "mode": "absolute", "steps": [ { "color": "red", "value": null }, { "color": "yellow", "value": 15 }, { "color": "green", "value": 50 } ] }
        }
      }
    },
    {
      "id": 3,
      "title": "Tiempo de despliegue (ultimo build CI)",
      "type": "stat",
      "datasource": { "type": "prometheus", "uid": "prometheus_ds" },
      "gridPos": { "h": 6, "w": 6, "x": 12, "y": 0 },
      "targets": [
        { "expr": "saludplus_deploy_duration_seconds", "legendFormat": "duracion" }
      ],
      "fieldConfig": { "defaults": { "unit": "s" } }
    },
    {
      "id": 4,
      "title": "Errores HTTP acumulados (4xx/5xx)",
      "type": "stat",
      "datasource": { "type": "prometheus", "uid": "prometheus_ds" },
      "gridPos": { "h": 6, "w": 6, "x": 18, "y": 0 },
      "targets": [
        { "expr": "sum(http_server_requests_seconds_count{status=~\"4..|5..\"})", "legendFormat": "errores" }
      ],
      "fieldConfig": {
        "defaults": {
          "thresholds": { "mode": "absolute", "steps": [ { "color": "green", "value": null }, { "color": "red", "value": 1 } ] }
        }
      }
    },
    {
      "id": 5,
      "title": "Requests HTTP por endpoint (tasa por segundo)",
      "type": "timeseries",
      "datasource": { "type": "prometheus", "uid": "prometheus_ds" },
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 6 },
      "targets": [
        { "expr": "sum(rate(http_server_requests_seconds_count[1m])) by (uri)", "legendFormat": "{{uri}}" }
      ]
    },
    {
      "id": 6,
      "title": "Tasa de errores HTTP (5xx) por segundo",
      "type": "timeseries",
      "datasource": { "type": "prometheus", "uid": "prometheus_ds" },
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 6 },
      "targets": [
        { "expr": "sum(rate(http_server_requests_seconds_count{status=~\"5..\"}[1m]))", "legendFormat": "errores 5xx" }
      ]
    },
    {
      "id": 7,
      "title": "Uso de CPU del proceso (%)",
      "type": "timeseries",
      "datasource": { "type": "prometheus", "uid": "prometheus_ds" },
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 14 },
      "targets": [
        { "expr": "process_cpu_usage * 100", "legendFormat": "cpu %" }
      ],
      "fieldConfig": { "defaults": { "unit": "percent" } }
    },
    {
      "id": 8,
      "title": "Uso de memoria JVM (heap)",
      "type": "timeseries",
      "datasource": { "type": "prometheus", "uid": "prometheus_ds" },
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 14 },
      "targets": [
        { "expr": "sum(jvm_memory_used_bytes{area=\"heap\"})", "legendFormat": "heap usado" }
      ],
      "fieldConfig": { "defaults": { "unit": "bytes" } }
    }
  ]
}
